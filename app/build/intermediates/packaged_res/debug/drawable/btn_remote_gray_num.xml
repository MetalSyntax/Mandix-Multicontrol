<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#9EA2AB" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#000000" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#D8DBE2"
                android:centerColor="#C0C4CC"
                android:endColor="#A9ADB6" />
            <corners android:radius="16dp" />
            <stroke android:width="0.8dp" android:color="#2C2E35" />
        </shape>
    </item>
</selector>
