<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_remote_chassis"
    android:padding="20dp">

    <!-- Cabecera con estética del control -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📡 BÚSQUEDA AUTOMÁTICA RM-014S+"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <Button
            android:id="@+id/btnCancelScan"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textSize="18sp"
            android:textColor="#9CA3AF" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Configura la frecuencia y el modo antes de iniciar el barrido"
        android:textColor="#9CA3AF"
        android:textSize="11sp" />

    <!-- 1. Menú desplegable para la Frecuencia (Look & Feel del control) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Frecuencia Portadora IR:"
        android:textColor="@color/amber_accent"
        android:textSize="11sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerFrequency"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/btn_remote_dark_pill"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark" />

    <!-- 2. Menú desplegable para Tipo de Barrido -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Modo de Búsqueda:"
        android:textColor="@color/amber_accent"
        android:textSize="11sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerScanMode"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/btn_remote_dark_pill"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark" />

    <!-- 3. Botón para Iniciar / Detener el Escaneo -->
    <LinearLayout
        android:id="@+id/layoutScanControlsBefore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnStartScan"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="▶ Iniciar Búsqueda Automática"
            android:textColor="@color/black_bg"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="@color/amber_accent" />

        <!-- Botón Test de Cámara -->
        <Button
            android:id="@+id/btnTestCameraLed"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:text="📷 Probar Emisor (Ver en Cámara de otro móvil)"
            android:textSize="11sp"
            android:textColor="#38BDF8"
            android:strokeColor="#38BDF8" />
    </LinearLayout>

    <!-- 4. Caja de Progreso del Escaneo (Estilo Pantalla OLED de control) -->
    <LinearLayout
        android:id="@+id/layoutScanProgressBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#121316"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvScanStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Listo para iniciar"
            android:textColor="@color/amber_accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvScanHex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0x00"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvScanDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selecciona la frecuencia y presiona Iniciar"
            android:textColor="#9CA3AF"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/progressBarScan"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="255"
            android:progress="0" />
    </LinearLayout>

    <!-- 5. Botón GIGANTE ¡DETENER / GUARDAR! con estilo de goma -->
    <Button
        android:id="@+id/btnStopAndSave"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:text="¡DETENER / GUARDAR!"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#10B981" />

    <!-- 6. Controles de ajuste fino -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <Button
            android:id="@+id/btnStepBack"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="1 Atrás"
            android:textSize="11sp"
            android:textColor="#D1D5DB" />

        <Button
            android:id="@+id/btnPauseResume"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="Pausar"
            android:textSize="11sp"
            android:textColor="#D1D5DB" />

        <Button
            android:id="@+id/btnTestVol"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Probar"
            android:textSize="11sp"
            android:textColor="@color/amber_accent" />
    </LinearLayout>

</LinearLayout>
