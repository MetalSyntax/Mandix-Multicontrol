<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_remote_chassis"
    android:padding="20dp">

    <!-- Cabecera -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📡 Búsqueda Extendida RM-014S+"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Apunta tu Tecno Camon 30 al sensor del TV (1.5 - 2m)"
        android:textColor="#9CA3AF"
        android:textSize="12sp" />

    <!-- Selector de Frecuencia -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Frecuencia Portadora:"
        android:textColor="#D1D5DB"
        android:textSize="11sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgFrequency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb38k"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="38 kHz"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rb36k"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="36 kHz"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <RadioButton
            android:id="@+id/rb40k"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="40 kHz"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <RadioButton
            android:id="@+id/rb56k"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="56 kHz"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </RadioGroup>

    <!-- Caja de Progreso del Código -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#121316"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvScanStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transmitiendo ráfagas VOL+..."
            android:textColor="@color/amber_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvScanHex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0x00 (014)"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvScanDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dirección: 0x00 • Freq: 38kHz • Pulso: VOL+ (x2)"
            android:textColor="#9CA3AF"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/progressBarScan"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="10dp"
            android:max="255"
            android:progress="0" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="En cuanto el TV muestre volumen o reaccione, presiona inmediatamente:"
        android:textColor="#E5E7EB"
        android:textSize="12sp"
        android:gravity="center" />

    <!-- Botón GIGANTE ¡DETENER / GUARDAR! -->
    <Button
        android:id="@+id/btnStopAndSave"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="10dp"
        android:text="¡DETENER / GUARDAR!"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#10B981" />

    <!-- Controles de ajuste fino -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <Button
            android:id="@+id/btnStepBack"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="1 Atrás"
            android:textSize="11sp"
            android:textColor="#D1D5DB" />

        <Button
            android:id="@+id/btnPauseResume"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="Pausar"
            android:textSize="11sp"
            android:textColor="#D1D5DB" />

        <Button
            android:id="@+id/btnTestVol"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Probar"
            android:textSize="11sp"
            android:textColor="@color/amber_accent" />
    </LinearLayout>

    <Button
        android:id="@+id/btnCancelScan"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cerrar"
        android:textColor="#9CA3AF" />

</LinearLayout>
