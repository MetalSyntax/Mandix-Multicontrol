<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_remote_chassis"
    android:padding="18dp">

    <!-- Cabecera -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📖 Manual Oficial y Especificaciones"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCloseManual"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/btn_remote_dark_pill"
            android:text="✕"
            android:textSize="13sp"
            android:textColor="#9CA3AF"
            android:padding="0dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TABLA DE ESPECIFICACIONES 1:1 -->
            <TextView
                android:id="@+id/tvManualDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#121316"
                android:padding="8dp"
                android:text="Emitiendo desde: —"
                android:textColor="@color/amber_accent"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="📋 FICHA TÉCNICA (SPECIFICATIONS)"
                android:textColor="@color/amber_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#121316"
                android:padding="8dp"
                android:stretchColumns="1">

                <TableRow android:padding="3dp">
                    <TextView android:text="Model Number:" android:textColor="#9CA3AF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:text="RM-014S+ / RM-014S+PLUS" android:textColor="@color/white" android:textSize="11sp" android:fontFamily="monospace" />
                </TableRow>
                <TableRow android:padding="3dp">
                    <TextView android:text="Brand Name:" android:textColor="#9CA3AF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:text="XingZhiHua / i-MARSTAR (AMELY)" android:textColor="@color/white" android:textSize="11sp" />
                </TableRow>
                <TableRow android:padding="3dp">
                    <TextView android:text="Communication:" android:textColor="#9CA3AF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:text="IR (Infrared) ConsumerIrManager" android:textColor="@color/white" android:textSize="11sp" />
                </TableRow>
                <TableRow android:padding="3dp">
                    <TextView android:text="IR Carrier:" android:textColor="#9CA3AF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:text="38 kHz fija (NEC). 36/40/56 kHz solo diagnóstico" android:textColor="@color/white" android:textSize="11sp" />
                </TableRow>
                <TableRow android:padding="3dp">
                    <TextView android:text="Channel / Use:" android:textColor="#9CA3AF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:text="Channel 3 • TV LCD / LED / Smart" android:textColor="@color/white" android:textSize="11sp" />
                </TableRow>
                <TableRow android:padding="3dp">
                    <TextView android:text="Material:" android:textColor="#9CA3AF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:text="New ABS &amp; Memory IC" android:textColor="@color/white" android:textSize="11sp" />
                </TableRow>
                <TableRow android:padding="3dp">
                    <TextView android:text="Certification:" android:textColor="#9CA3AF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:text="CE, RoHS" android:textColor="@color/white" android:textSize="11sp" />
                </TableRow>
                <TableRow android:padding="3dp">
                    <TextView android:text="Origin:" android:textColor="#9CA3AF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:text="Mainland China" android:textColor="@color/white" android:textSize="11sp" />
                </TableRow>
                <TableRow android:padding="3dp">
                    <TextView android:text="Dimensions &amp; W:" android:textColor="#9CA3AF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:text="Approx. 10x10x10cm • 0.1 kg" android:textColor="@color/white" android:textSize="11sp" />
                </TableRow>
            </TableLayout>

            <!-- CONSEJOS OFICIALES (USER TIPS) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="💡 CONSEJOS CLAVE (USER TIPS)"
                android:textColor="@color/amber_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#121316"
                android:padding="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• La paciencia es clave: La configuración universal puede requerir probar varios métodos o códigos. Si el primero no responde, prueba el siguiente método."
                    android:textColor="#E5E7EB"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvManualLineOfSight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="• Línea de visión directa: Asegura siempre una línea directa sin obstáculos entre el emisor IR superior de tu equipo y el receptor de la TV."
                    android:textColor="#E5E7EB"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="• Probar todas las funciones: Al finalizar el emparejamiento, prueba Power, VOL+, VOL-, CH y Menú para confirmar compatibilidad total."
                    android:textColor="#E5E7EB"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- LOS 5 MÉTODOS OFICIALES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="⚙️ LOS 5 MÉTODOS DE CONFIGURACIÓN"
                android:textColor="@color/amber_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#121316"
                android:padding="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Método 1: Setting with Brand Code (SET + Tecla)"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sostén SET y presiona el número de tu marca (1: LG, 2: SONY, 3: SAMSUNG, 4: SHARP, 5: PANASONIC, 6: TOSHIBA, 7: PHILIPS, 8: HAIER, 9: HITACHI, 0: TCL/KONKA). El LED parpadeará 3 veces."
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Método 2: Setting with Code (Código de 3 Dígitos)"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Presiona SET + POWER (el LED se encenderá fijo). Ingresa los 3 números de la lista (ej: 014, 005, 025, 038 para placas chinas CX-507). El LED se apagará."
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Método 3: One Key Search (Búsqueda por Volumen)"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mantén presionado SET apuntando a la TV. El control emitirá ráfagas de volumen consecutivas. En cuanto veas la barra de volumen en pantalla, suelta SET inmediatamente."
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Método 4: One By One Search (Canal / Volumen Paso a Paso)"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Presiona CH+ o CH- uno por uno observando tu televisor. Cuando cambie, presiona SET para fijar."
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Método 5: Automatic Search (Búsqueda Automática)"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Presiona SET o la placa inferior. El escáner recorrerá todos los códigos en la frecuencia seleccionada. Presiona DETENER / GUARDAR al ver el volumen."
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Bloqueo / Desbloqueo (Lock / Unlock):"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Presiona SET + OK para bloquear el sistema contra cambios accidentales. Presiona SET + OK otra vez para desbloquear."
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAcceptManual"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/btn_remote_pill_amber"
        android:text="✔ ENTENDIDO / VOLVER AL CONTROL"
        android:textColor="#111215"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

</LinearLayout>
