<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_remote_chassis"
    android:padding="18dp">

    <!-- Cabecera -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/manual_title"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCloseManual"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/btn_remote_dark_pill"
            android:text="✕"
            android:textSize="13sp"
            android:textColor="#9CA3AF"
            android:padding="0dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TABLA DE ESPECIFICACIONES 1:1 -->
            <TextView
                android:id="@+id/tvManualDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#121316"
                android:padding="8dp"
                android:text=""
                android:textColor="@color/amber_accent"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/manual_specs"
                android:textColor="@color/amber_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#121316"
                android:padding="8dp"
                android:stretchColumns="1">

                <TableRow android:padding="3dp">
                    <TextView android:text="@string/spec_model" android:textColor="#9CA3AF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:text="RM-014S+ / RM-014S+PLUS" android:textColor="@color/white" android:textSize="11sp" android:fontFamily="monospace" />
                </TableRow>
                <TableRow android:padding="3dp">
                    <TextView android:text="@string/spec_brand" android:textColor="#9CA3AF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:text="XingZhiHua / i-MARSTAR (AMELY)" android:textColor="@color/white" android:textSize="11sp" />
                </TableRow>
                <TableRow android:padding="3dp">
                    <TextView android:text="@string/spec_comm" android:textColor="#9CA3AF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:text="IR (Infrared) ConsumerIrManager" android:textColor="@color/white" android:textSize="11sp" />
                </TableRow>
                <TableRow android:padding="3dp">
                    <TextView android:text="@string/spec_carrier" android:textColor="#9CA3AF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:text="@string/spec_carrier_value" android:textColor="@color/white" android:textSize="11sp" />
                </TableRow>
                <TableRow android:padding="3dp">
                    <TextView android:text="@string/spec_use" android:textColor="#9CA3AF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:text="@string/spec_use_value" android:textColor="@color/white" android:textSize="11sp" />
                </TableRow>
                <TableRow android:padding="3dp">
                    <TextView android:text="@string/spec_material" android:textColor="#9CA3AF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:text="@string/spec_material_value" android:textColor="@color/white" android:textSize="11sp" />
                </TableRow>
                <TableRow android:padding="3dp">
                    <TextView android:text="@string/spec_cert" android:textColor="#9CA3AF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:text="CE, RoHS" android:textColor="@color/white" android:textSize="11sp" />
                </TableRow>
                <TableRow android:padding="3dp">
                    <TextView android:text="@string/spec_origin" android:textColor="#9CA3AF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:text="@string/spec_origin_value" android:textColor="@color/white" android:textSize="11sp" />
                </TableRow>
                <TableRow android:padding="3dp">
                    <TextView android:text="@string/spec_dims" android:textColor="#9CA3AF" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:text="@string/spec_dims_value" android:textColor="@color/white" android:textSize="11sp" />
                </TableRow>
            </TableLayout>

            <!-- CONSEJOS OFICIALES (USER TIPS) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/manual_tips"
                android:textColor="@color/amber_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#121316"
                android:padding="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/manual_tip_patience"
                    android:textColor="#E5E7EB"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvManualLineOfSight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text=""
                    android:textColor="#E5E7EB"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/manual_tip_all"
                    android:textColor="#E5E7EB"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- LOS 5 MÉTODOS OFICIALES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/manual_methods"
                android:textColor="@color/amber_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#121316"
                android:padding="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m1_title"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m1_body"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/m2_title"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m2_body"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/m3_title"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m3_body"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/m4_title"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m4_body"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/m5_title"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m5_body"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/lock_title"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lock_body"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAcceptManual"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/btn_remote_pill_amber"
        android:text="@string/btn_manual_ok"
        android:textColor="#111215"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

</LinearLayout>
