<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_remote_chassis"
    android:padding="20dp">

    <!-- Cabecera con estética del control -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/scan_title"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelScan"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/btn_remote_dark_pill"
            android:text="✕"
            android:textSize="13sp"
            android:textColor="#9CA3AF"
            android:padding="0dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/scan_subtitle"
        android:textColor="#9CA3AF"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvScanHwInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#121316"
        android:padding="8dp"
        android:text=""
        android:textColor="#9CA3AF"
        android:textSize="10sp"
        android:fontFamily="monospace" />

    <!-- 1. Menú desplegable para la Frecuencia (Look & Feel del control) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/scan_freq_label"
        android:textColor="@color/amber_accent"
        android:textSize="11sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerFrequency"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/btn_remote_dark_pill"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark" />

    <!-- 2. Menú desplegable para Tipo de Barrido -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/scan_mode_label"
        android:textColor="@color/amber_accent"
        android:textSize="11sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerScanMode"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/btn_remote_dark_pill"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark" />

    <!-- 3. Botón para Iniciar / Detener el Escaneo -->
    <LinearLayout
        android:id="@+id/layoutScanControlsBefore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStartScan"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/btn_remote_pill_amber"
            android:text="@string/btn_start_scan"
            android:textColor="#111215"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <!-- Botón Test de Cámara -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTestCameraLed"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_remote_dark_pill"
            android:text="@string/btn_test_camera"
            android:textSize="11sp"
            android:textColor="#38BDF8"
            android:textStyle="bold"
            android:letterSpacing="0.03" />
    </LinearLayout>

    <!-- 4. Caja de Progreso del Escaneo (Estilo Pantalla OLED de control) -->
    <LinearLayout
        android:id="@+id/layoutScanProgressBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#121316"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvScanStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_ready"
            android:textColor="@color/amber_accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvScanHex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvScanDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_hint"
            android:textColor="#9CA3AF"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/progressBarScan"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="255"
            android:progress="0" />
    </LinearLayout>

    <!-- 5. Botón GIGANTE ¡DETENER / GUARDAR! con estilo de goma del control -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnStopAndSave"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/btn_remote_pill_green"
        android:text="@string/btn_stop_save"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <!-- 6. Controles de ajuste fino estilo botones físicos del control -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStepBack"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/btn_remote_dark_pill"
            android:text="@string/btn_step_back"
            android:textSize="11sp"
            android:textColor="#E5E7EB"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPauseResume"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/btn_remote_dark_pill"
            android:text="@string/btn_pause"
            android:textSize="11sp"
            android:textColor="@color/amber_accent"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTestVol"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/btn_remote_dark_pill"
            android:text="@string/btn_test"
            android:textSize="11sp"
            android:textColor="#34D399"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
