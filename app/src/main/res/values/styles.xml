<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Controles simulados (Amazon, Roku, cornetas, aires): tecla base, el color va en backgroundTint -->
    <style name="Sk">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#E5E5E5</item>
        <item name="android:background">@drawable/sk_circle</item>
        <item name="android:backgroundTint">#2A2A2C</item>
        <item name="android:backgroundTintMode">multiply</item>
    </style>

    <style name="Sk.Pill">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:background">@drawable/sk_pill</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Sk.Key">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:background">@drawable/sk_key</item>
        <item name="android:backgroundTint">#A3A3A3</item>
        <item name="android:textColor">#1E1E1E</item>
        <item name="android:textSize">10sp</item>
    </style>

    <!-- Zona táctil sin fondo (flechas dibujadas sobre un aro) -->
    <style name="Sk.Flat">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:backgroundTint">@null</item>
    </style>

    <style name="SkRow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center_horizontal</item>
    </style>

    <style name="SkBody">
        <item name="android:layout_width">200dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/sk_body</item>
        <item name="android:backgroundTint">#1E1E20</item>
        <item name="android:backgroundTintMode">multiply</item>
        <item name="android:elevation">6dp</item>
    </style>

    <!-- Rótulo impreso en el control -->
    <style name="SkLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">7sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#4B4B4B</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
