# Mando chino de 21 teclas (módulos MP3/BT de cornetas genéricas): NEC dirección 0x00.
# Fila superior POWER / MODE / MUTE; en la variante "Car MP3" las mismas teclas son CH- / CH / CH+.
#
name: Power
brand: China MP3/BT
type: parsed
protocol: NEC
address: 00 00 00 00
command: 45 00 00 00
